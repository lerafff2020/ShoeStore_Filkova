<Window x:Class="ShoeStore_Filkova.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Filkova"
        mc:Ignorable="d"
        Title="ООО Обувь - Авторизация"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка с логотипом -->
        <Border Grid.Row="0" Background="#7FFF00" Margin="10" Padding="15" CornerRadius="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="Images/logo.png" Width="70" Height="70"/>
                <TextBlock Text="Авторизация" FontSize="28" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Логин" FontSize="16"/>
            <TextBox Name="TbLogin" Height="30" FontSize="14" Margin="0,5,0,15"/>

            <TextBlock Text="Пароль" FontSize="16"/>
            <PasswordBox Name="PbPassword" Height="30" FontSize="14" Margin="0,5,0,15"/>

            <Button Name="BtnLogin" Content="Войти" Height="40" FontSize="16"
                    Background="#00FA9A" Click="BtnLogin_Click"/>

            <Button Name="BtnGuest" Content="Войти как гость" Height="35" FontSize="14"
                    Margin="0,10,0,0" Click="BtnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>