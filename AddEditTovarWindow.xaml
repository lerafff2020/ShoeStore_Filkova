<Window x:Class="ShoeStore_Filkova.AddEditTovarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Filkova"
        mc:Ignorable="d"
       Title="Добавление/редактирование товара"
        Height="720" Width="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="White"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Margin="10" Padding="15" CornerRadius="10">
            <TextBlock Text="Управление товаром" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,10,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ID -->
                <TextBlock Grid.Row="0" Text="ID товара:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="TbID"
                         IsReadOnly="True" Height="28" FontSize="14"
                         Margin="0,5" Background="#EEEEEE"/>

                <!-- Артикул -->
                <TextBlock Grid.Row="1" Text="Артикул:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TbArticle"
                         Height="28" FontSize="14" Margin="0,5"
                         Text="{Binding Article}"/>

                <!-- Фото -->
                <TextBlock Grid.Row="2" Text="Фото товара:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                    <Image Name="ImgPhoto" Width="120" Height="90" Stretch="Uniform"
                           Source="{Binding Photo, TargetNullValue='pack://application:,,,/Images/picture.png'}"/>
                    <Button Name="BtnSelectImage" Content="Выбрать изображение"
                            Padding="10,5" Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnSelectImage_Click"/>
                </StackPanel>

                <!-- Наименование товара -->
                <TextBlock Grid.Row="3" Text="Наименование товара:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Name="CmbProductName"
                          Height="28" FontSize="14" Margin="0,5"
                          DisplayMemberPath="Name"
                          SelectedValuePath="ID"
                          SelectedValue="{Binding ProductNameID}"/>

                <!-- Категория -->
                <TextBlock Grid.Row="4" Text="Категория товара:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Name="CmbCategory"
                          Height="28" FontSize="14" Margin="0,5"
                          DisplayMemberPath="Name"
                          SelectedValuePath="ID"
                          SelectedValue="{Binding CategoryID}"/>

                <!-- Описание -->
                <TextBlock Grid.Row="5" Text="Описание товара:" VerticalAlignment="Top"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="5" Grid.Column="1" Name="TbDescription"
                         Height="80" FontSize="14" Margin="0,5"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Description}"/>

                <!-- Производитель -->
                <TextBlock Grid.Row="6" Text="Производитель товара:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <ComboBox Grid.Row="6" Grid.Column="1" Name="CmbManufacturer"
                          Height="28" FontSize="14" Margin="0,5"
                          DisplayMemberPath="Name"
                          SelectedValuePath="ID"
                          SelectedValue="{Binding ManufacturerID}"/>

                <!-- Поставщик -->
                <TextBlock Grid.Row="7" Text="Поставщик товара:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <ComboBox Grid.Row="7" Grid.Column="1" Name="CmbSupplier"
                          Height="28" FontSize="14" Margin="0,5"
                          DisplayMemberPath="Name"
                          SelectedValuePath="ID"
                          SelectedValue="{Binding SupplierID}"/>

                <!-- Цена -->
                <TextBlock Grid.Row="8" Text="Цена товара:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="8" Grid.Column="1" Name="TbPrice"
                         Height="28" FontSize="14" Margin="0,5"
                         PreviewTextInput="TbPrice_PreviewTextInput"
                         Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Единица измерения -->
                <TextBlock Grid.Row="9" Text="Единица измерения:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="9" Grid.Column="1" Name="TbUnit"
                         Height="28" FontSize="14" Margin="0,5"
                         Text="{Binding Unit}"/>

                <!-- Кол-во на складе -->
                <TextBlock Grid.Row="10" Text="Количество на складе:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="10" Grid.Column="1" Name="TbStockQuantity"
                         Height="28" FontSize="14" Margin="0,5"
                         PreviewTextInput="TbStockQuantity_PreviewTextInput"
                         Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Скидка -->
                <TextBlock Grid.Row="11" Text="Действующая скидка:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="11" Grid.Column="1" Name="TbDiscount"
                         Height="28" FontSize="14" Margin="0,5"
                         PreviewTextInput="TbDiscount_PreviewTextInput"
                         Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Кнопка сохранить -->
                <Button Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                        Name="BtnSave" Content="Сохранить данные"
                        Height="40" FontSize="16" Margin="0,20,0,0"
                        Background="#00FA9A"
                        HorizontalAlignment="Center" Width="250"
                        Click="BtnSave_Click"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>