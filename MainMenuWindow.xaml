<Window x:Class="ShoeStore_Filkova.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Filkova"
        mc:Ignorable="d"
        Title="ООО Обувь - Список товаров"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА  -->
        <Border Grid.Row="0" Background="#7FFF00" Margin="10" Padding="10" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопки слева -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Name="BtnLogout"
                            Content="Выйти из системы"
                            Padding="10,5" FontSize="14"
                            Background="#00FA9A"
                            Click="BtnLogout_Click"/>

                    <Button Name="BtnOrders"
        Content="Заказы"
        Padding="10,5" FontSize="14" Margin="10,0,0,0"
        Background="#00FA9A"
        Visibility="Collapsed"
        Click="BtnOrders_Click"/>

                    <Button Name="BtnAddProduct"
                            Content="Добавить товар"
                            Padding="10,5" FontSize="14" Margin="10,0,0,0"
                            Background="#00FA9A"
                            Visibility="Collapsed"
                            Click="BtnAddProduct_Click"/>

                    <Button Name="BtnDeleteProduct"
                            Content="Удалить товар"
                            Padding="10,5" FontSize="14" Margin="10,0,0,0"
                            Background="#00FA9A"
                            Visibility="Collapsed"
                            Click="BtnDeleteProduct_Click"/>
                </StackPanel>

                <!-- Логотип и заголовок по центру -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Image Source="Images/logo.png" Width="60" Height="60"/>
                    <TextBlock Text="ООО Обувь" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>

                <!-- ФИО справа -->
                <TextBlock Grid.Column="2" Name="TbUserInfo"
                           FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ПАНЕЛЬ ФИЛЬТРОВ-->
        <Border Grid.Row="1" Background="#7FFF00" Margin="10,0,10,10" Padding="10" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" FontSize="14" VerticalAlignment="Center"/>
                    <TextBox Name="TbSearch" Width="200" Height="28" FontSize="14"
                             Margin="5,0,15,0"
                             TextChanged="TbSearch_TextChanged"/>
                </StackPanel>

                <!-- Сортировка -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сортировка (по кол-ву на складе):"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Name="BtnSortAsc" Content="По возрастанию"
                            Padding="10,5" FontSize="13" Margin="0,0,5,0"
                            Click="BtnSortAsc_Click"/>
                    <Button Name="BtnSortDesc" Content="По убыванию"
                            Padding="10,5" FontSize="13"
                            Click="BtnSortDesc_Click"/>
                </StackPanel>

                <!-- Фильтр по поставщику -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="Поставщик:" FontSize="14" VerticalAlignment="Center"/>
                    <ComboBox Name="CmbSupplier" Width="180" Height="28" FontSize="14"
                              Margin="5,0,0,0"
                              DisplayMemberPath="Name"
                              SelectionChanged="CmbSupplier_SelectionChanged"/>
                </StackPanel>

                <!-- Сброс -->
                <Button Grid.Column="3" Name="BtnReset" Content="Сбросить фильтры"
                        Padding="10,5" FontSize="13" Margin="15,0,0,0"
                        Click="BtnReset_Click"/>
            </Grid>
        </Border>

        <!-- СПИСОК ТОВАРОВ  -->
        <ListView Name="ListTovar" Grid.Row="2" Margin="10"
                  MouseDoubleClick="ListTovar_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_discount}" Value="True">
                            <Setter Property="Background" Value="#2E8B57"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding is_quantity}" Value="True">
                            <Setter Property="Background" Value="Cyan"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="700"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Фото -->
                            <Border Grid.Column="0" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <Image Source="{Binding Photo, TargetNullValue='pack://application:,,,/Images/picture.png'}"
                                       Margin="10" Width="120" Height="120" Stretch="Uniform"/>
                            </Border>

                            <!-- Информация -->
                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel Margin="5" Orientation="Vertical">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Categories.Name}" FontWeight="Bold"/>
                                        <TextBlock Text=" | " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Product_Names.Name}" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Описание товара: "/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: "/>
                                        <TextBlock Text="{Binding Manufacturers.Name}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: "/>
                                        <TextBlock Text="{Binding Suppliers.Name}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding Price}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0"
                                                   Text="{Binding price_discount, StringFormat='Новая цена: {0:F2} руб.'}"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: "/>
                                        <TextBlock Text="{Binding Unit}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: "/>
                                        <TextBlock Text="{Binding StockQuantity}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- Скидка -->
                            <Border Grid.Column="2" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Действующая" HorizontalAlignment="Center"/>
                                    <TextBlock Text="скидка" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Discount, StringFormat='{}{0}%'}"
                                               FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>