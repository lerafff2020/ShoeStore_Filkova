<Window x:Class="ShoeStore_Filkova.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Filkova"
        mc:Ignorable="d"
        Title="ООО Обувь - Список заказов"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Margin="10" Padding="10" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Name="BtnAddOrder"
                            Content="Добавить заказ"
                            Padding="10,5" FontSize="14"
                            Background="#00FA9A"
                            Visibility="Collapsed"
                            Click="BtnAddOrder_Click"/>

                    <Button Name="BtnDeleteOrder"
                            Content="Удалить заказ"
                            Padding="10,5" FontSize="14" Margin="10,0,0,0"
                            Background="#00FA9A"
                            Visibility="Collapsed"
                            Click="BtnDeleteOrder_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Image Source="Images/logo.png" Width="50" Height="50"/>
                    <TextBlock Text="Заказы" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="15,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Name="TbUserInfo"
                           FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Список заказов -->
        <ListView Name="ListOrders" Grid.Row="1" Margin="10"
                  MouseDoubleClick="ListOrders_MouseDoubleClick">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" Padding="10" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Артикул заказа: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding PickupCode}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Статус заказа: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Order_Status.StatusName}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Адрес пункта выдачи: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding pickup_points.Locality}"/>
                                    <TextBlock Text=", "/>
                                    <TextBlock Text="{Binding pickup_points.Street}"/>
                                    <TextBlock Text=", д. "/>
                                    <TextBlock Text="{Binding pickup_points.HouseNumber}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дата заказа: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat='dd.MM.yyyy'}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Дата доставки" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DeliveryDate, StringFormat='dd.MM.yyyy'}"
                                               FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>