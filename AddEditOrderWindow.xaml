<Window x:Class="ShoeStore_Filkova.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Filkova"
        mc:Ignorable="d"
        Title="Добавление/редактирование заказа"
        Height="620" Width="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="White"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Margin="10" Padding="15" CornerRadius="10">
            <TextBlock Text="Управление заказом" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,10,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ID -->
                <TextBlock Grid.Row="0" Text="ID заказа:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="TbID"
                         IsReadOnly="True" Height="28" FontSize="14"
                         Margin="0,5" Background="#EEEEEE"/>

                <!-- Артикул заказа (PickupCode) -->
                <TextBlock Grid.Row="1" Text="Артикул заказа:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TbPickupCode"
                         Height="28" FontSize="14" Margin="0,5"
                         Text="{Binding PickupCode}"/>

                <!-- Статус заказа -->
                <TextBlock Grid.Row="2" Text="Статус заказа:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Name="CmbStatus"
                          Height="28" FontSize="14" Margin="0,5"
                          DisplayMemberPath="StatusName"
                          SelectedValuePath="ID"
                          SelectedValue="{Binding StatusID}"/>

                <!-- Адрес ПВЗ -->
                <TextBlock Grid.Row="3" Text="Адрес пункта выдачи:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Name="CmbPickupPoint"
                          Height="28" FontSize="14" Margin="0,5"
                          SelectedValuePath="ID"
                          SelectedValue="{Binding PickupPointID}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Показываем "город, улица, дом" -->
                            <TextBlock>
                                <Run Text="{Binding Locality}"/>
                                <Run Text=", "/>
                                <Run Text="{Binding Street}"/>
                                <Run Text=", д. "/>
                                <Run Text="{Binding HouseNumber}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Дата заказа -->
                <TextBlock Grid.Row="4" Text="Дата заказа:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <DatePicker Grid.Row="4" Grid.Column="1" Name="DpOrderDate"
                            Height="28" FontSize="14" Margin="0,5"
                            SelectedDate="{Binding OrderDate}"/>

                <!-- Дата доставки -->
                <TextBlock Grid.Row="5" Text="Дата выдачи:" VerticalAlignment="Center"
                           FontSize="14" Margin="0,5"/>
                <DatePicker Grid.Row="5" Grid.Column="1" Name="DpDeliveryDate"
                            Height="28" FontSize="14" Margin="0,5"
                            SelectedDate="{Binding DeliveryDate}"/>

                <!-- Кнопка -->
                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                        Name="BtnSave" Content="Сохранить данные"
                        Height="40" FontSize="16" Margin="0,20,0,0"
                        Background="#00FA9A"
                        HorizontalAlignment="Center" Width="250"
                        Click="BtnSave_Click"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
